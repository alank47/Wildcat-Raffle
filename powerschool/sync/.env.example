# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Secrets are 1Password references, not values. The npm scripts run through
# `op run --env-file=.env`, which resolves each op:// reference at process
# start, injects it as an environment variable, and masks it in output. The
# secret is never written to this file, never written to disk, and never
# reaches the Dropbox sync in this folder.
#
# Requires `op signin` first. Check with: op whoami
#
# Everything that is NOT a secret is a plain value below. Only the two
# credential lines use op://.

# ---------------------------------------------------------------------------
# PowerSchool
# ---------------------------------------------------------------------------
# Hostname only. No scheme, no trailing slash.
# This MUST be the test or sandbox instance. The probe refuses to run against
# a host that looks like production unless PS_ALLOW_PRODUCTION=yes is set,
# and setting that is a decision to escalate, not a decision to make alone.
PS_HOST=

# Generated by PowerSchool when the plugin is enabled.
# Plugin Management Configuration > Wildcat Hub Sync > Data Provider Configuration
PS_CLIENT_ID="op://Employee/WildCats Hub/SIS Client ID"
PS_CLIENT_SECRET="op://Employee/WildCats Hub/SIS Client Secret"

# Escape hatch. Leave empty. Setting this to "yes" points read only traffic at
# a live student database and requires sign off first.
PS_ALLOW_PRODUCTION=

# ---------------------------------------------------------------------------
# Scope for this run
# ---------------------------------------------------------------------------
# Schools.ID for Westbrook Academy in this instance. The probe prints the
# candidates if you leave it blank.
PS_SCHOOL_ID=

# PowerSchool year id. 2025-2026 is 35, 2026-2027 is 36. Confirm rather than
# assume: the terms query prints what actually exists.
PS_YEAR_ID=

# Terms.ID for the term being validated, and the full year record term id.
# Run "npm run queries -- terms" first to discover both.
PS_TERM_ID=
PS_YEAR_TERM_ID=

# PGFinalGrades.FinalGradeName for the current reporting term, for example Q1.
PS_FINAL_GRADE_NAME=
# StoredGrades.StoreCode fallback for the same reporting term, for example Q1.
PS_STORE_CODE=

# ---------------------------------------------------------------------------
# Probe behaviour
# ---------------------------------------------------------------------------
# One known good student number to probe field by field. Use a sandbox record.
PS_SAMPLE_STUDENT_NUMBER=

# Assumed per plugin hourly request ceiling. The client logs request counts per
# run and aborts before crossing this.
PS_HOURLY_REQUEST_CEILING=3000

# Page size for table endpoint reads. PowerSchool caps this and the probe
# reports the server enforced maximum.
PS_PAGE_SIZE=100
