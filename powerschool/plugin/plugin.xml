<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wildcat Hub PowerSchool data access plugin.

  READ ONLY. Every field below is requested with access="ViewOnly".
  There is no write, update, or delete access anywhere in this file.
  If a future task appears to need a write, stop and escalate rather
  than editing this file.

  Restricted fields (federal ethnicity, federal race, English Learner
  status, and the future IEP / 504 sources) are grouped and commented
  so they can be removed as a block if the requester cannot name an
  operational use case. See docs/field-sourcing.md.

  Version history lives in docs/plugin-install.md. Bumping the version
  attribute is required for PowerSchool to accept a re-upload.
-->
<plugin xmlns="http://plugin.powerschool.pearson.com"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://plugin.powerschool.pearson.com plugin.xsd"
        name="Wildcat Hub Sync"
        version="1.3.1"
        description="Read only student and staff data sync for the Wildcat Hub teacher and admin dashboard at Westbrook Academy.">

  <publisher name="LA Promise Fund">
    <contact email="lawrenceb@lapromisefund.org"/>
  </publisher>

  <!-- Enables OAuth 2.0 client credentials. PowerSchool generates the
       client id and secret when the plugin is enabled. Never paste
       those values into this file or any other file in the repo. -->
  <oauth/>

  <access_request>

      <!-- ================================================================
           MANIFEST 1, 2, 3, 9: student identity and demographics (Standard)
           ================================================================ -->
      <field table="Students" field="ID"                  access="ViewOnly"/>
      <field table="Students" field="DCID"                access="ViewOnly"/>
      <field table="Students" field="Student_Number"      access="ViewOnly"/>
      <field table="Students" field="State_StudentNumber" access="ViewOnly"/>
      <field table="Students" field="First_Name"          access="ViewOnly"/>
      <field table="Students" field="Last_Name"           access="ViewOnly"/>
      <field table="Students" field="Grade_Level"         access="ViewOnly"/>
      <field table="Students" field="Gender"              access="ViewOnly"/>
      <field table="Students" field="SchoolID"            access="ViewOnly"/>
      <field table="Students" field="Enroll_Status"       access="ViewOnly"/>
      <field table="Students" field="EntryDate"           access="ViewOnly"/>
      <field table="Students" field="ExitDate"            access="ViewOnly"/>
      <!-- MANIFEST 19, Student Email. REMOVED 2026-08-12, and this is the
           reason, so nobody adds it back on the same hunch.

           Both spellings were requested on the theory that the column name is
           install specific. PowerSchool rejected BOTH at upload:

             STUDENTS  EMAIL          Invalid Column
             STUDENTS  STUDENT_EMAIL  Invalid Column

           and refused to enable the plugin at all. That is not a permission
           failure, it is PowerSchool saying the columns do not exist on the
           core table. Requesting a column that does not exist does not fail
           softly: it blocks the whole plugin, which took the sync down.

           Student email is real and lives in the UI at Student Profile > Email.
           It is NOT a column on STUDENTS. It is in the Person email model, and
           the fields for it are requested below. See docs/student-email-sourcing.md.
           ================================================================ -->

      <!-- ================================================================
           MANIFEST 19, Student Email. Added at 1.2.0.

           EVERY FIELD BELOW WAS CONFIRMED TO EXIST BEFORE IT WAS WRITTEN HERE.
           The table endpoint distinguishes the two failures, and that is the
           whole method:

             400 "not a valid column for table X"  the column does not exist
             403 "lacks sufficient permission"     it exists, we lack the grant

           Every line below answered 403 on 2026-08-12. Nothing here is a guess,
           because guessing is what got 1.1.0 rejected and took the sync down.

           The join, and why it needs four tables:

             STUDENTS.PERSON_ID
               -> PERSON.ID
               -> PERSONEMAILADDRESSASSOC.PERSONID
               -> PERSONEMAILADDRESSASSOC.EMAILADDRESSID
               -> EMAILADDRESS.EMAILADDRESSID -> EMAILADDRESS.EMAILADDRESS

           A person can hold several addresses, which is why the association
           table carries IsPrimaryEmailAddress and EmailAddressPriorityOrder.
           Picking one arbitrarily would hand a student someone else's address
           to sign in with, so both selectors are requested and the query orders
           by them explicitly.

           Ruled out by probe, so nobody retries them: Students.Student_Email,
           Students.Email, Students.Email_Addr, U_StudentsUserFields.*,
           StudentCoreFields.*, U_Def_Ext_Students.* (that table exists and has
           StudentsDCID, but no email column at all).
           ================================================================ -->
      <field table="Students" field="Person_Id" access="ViewOnly"/>

      <field table="Person" field="ID"   access="ViewOnly"/>
      <field table="Person" field="DCID" access="ViewOnly"/>

      <field table="PersonEmailAddressAssoc" field="PersonID"                  access="ViewOnly"/>
      <field table="PersonEmailAddressAssoc" field="EmailAddressID"            access="ViewOnly"/>
      <field table="PersonEmailAddressAssoc" field="IsPrimaryEmailAddress"     access="ViewOnly"/>
      <field table="PersonEmailAddressAssoc" field="EmailAddressPriorityOrder" access="ViewOnly"/>

      <field table="EmailAddress" field="EmailAddressID" access="ViewOnly"/>
      <field table="EmailAddress" field="EmailAddress"   access="ViewOnly"/>

      <!-- ================================================================
           MANIFEST 4, 5, 6: course, section, period, teacher assignment
           CC is the student to section enrollment table.
           ================================================================ -->
      <field table="CC" field="ID"          access="ViewOnly"/>
      <field table="CC" field="StudentID"   access="ViewOnly"/>
      <field table="CC" field="SectionID"   access="ViewOnly"/>
      <field table="CC" field="Course_Number" access="ViewOnly"/>
      <field table="CC" field="TermID"      access="ViewOnly"/>
      <field table="CC" field="SchoolID"    access="ViewOnly"/>
      <field table="CC" field="DateEnrolled" access="ViewOnly"/>
      <field table="CC" field="DateLeft"    access="ViewOnly"/>
      <field table="CC" field="Expression"  access="ViewOnly"/>

      <field table="Courses" field="ID"            access="ViewOnly"/>
      <field table="Courses" field="Course_Number" access="ViewOnly"/>
      <field table="Courses" field="Course_Name"   access="ViewOnly"/>
      <field table="Courses" field="SchoolID"      access="ViewOnly"/>

      <field table="Sections" field="ID"             access="ViewOnly"/>
      <field table="Sections" field="DCID"           access="ViewOnly"/>
      <field table="Sections" field="Course_Number"  access="ViewOnly"/>
      <field table="Sections" field="Section_Number" access="ViewOnly"/>
      <field table="Sections" field="Expression"     access="ViewOnly"/>
      <field table="Sections" field="Teacher"        access="ViewOnly"/>
      <field table="Sections" field="TermID"         access="ViewOnly"/>
      <field table="Sections" field="SchoolID"       access="ViewOnly"/>

      <!-- Period comes from SECTIONS.EXPRESSION and CC.EXPRESSION.
           SECTIONMEETING, PERIOD and CYCLE_DAY were requested in 1.0.0 and
           PowerSchool rejected SECTIONMEETING as an invalid table in this
           instance, which leaves no join path to PERIOD or CYCLE_DAY. They
           are removed rather than left as unusable granted access.
           Parsing EXPRESSION is a Phase 4 test requirement: one single
           period section, one multi period block, one alternating day
           section. See docs/field-sourcing.md for the question to the SIS
           admin about whether a meeting table exists under another name. -->

      <!-- ================================================================
           MANIFEST 15, 16, 17, 18: staff
           Sections.Teacher points at Teachers.ID. Email lives on Users.
           Teachers.Users_DCID is the bridge. Verify this link against the
           instance in Phase 0 before trusting it.
           ================================================================ -->
      <field table="Teachers" field="ID"           access="ViewOnly"/>
      <field table="Teachers" field="DCID"         access="ViewOnly"/>
      <field table="Teachers" field="Users_DCID"   access="ViewOnly"/>
      <field table="Teachers" field="TeacherNumber" access="ViewOnly"/>
      <field table="Teachers" field="First_Name"   access="ViewOnly"/>
      <field table="Teachers" field="Last_Name"    access="ViewOnly"/>
      <field table="Teachers" field="SchoolID"     access="ViewOnly"/>
      <field table="Teachers" field="Status"       access="ViewOnly"/>

      <field table="Users" field="DCID"          access="ViewOnly"/>
      <field table="Users" field="TeacherNumber" access="ViewOnly"/>
      <field table="Users" field="First_Name"    access="ViewOnly"/>
      <field table="Users" field="Last_Name"     access="ViewOnly"/>
      <field table="Users" field="Email_Addr"    access="ViewOnly"/>

      <field table="SchoolStaff" field="ID"          access="ViewOnly"/>
      <field table="SchoolStaff" field="DCID"        access="ViewOnly"/>
      <field table="SchoolStaff" field="Users_DCID"  access="ViewOnly"/>
      <field table="SchoolStaff" field="SchoolID"    access="ViewOnly"/>
      <field table="SchoolStaff" field="Status"      access="ViewOnly"/>
      <field table="SchoolStaff" field="StaffStatus" access="ViewOnly"/>

      <!-- ================================================================
           MANIFEST 10: attendance. Aggregation happens in the PowerQuery,
           not in application code. Presence_Status_CD is the field that
           decides what counts as an absence.
           ================================================================ -->
      <field table="Attendance" field="ID"                access="ViewOnly"/>
      <field table="Attendance" field="StudentID"         access="ViewOnly"/>
      <field table="Attendance" field="Att_Date"          access="ViewOnly"/>
      <field table="Attendance" field="Attendance_CodeID" access="ViewOnly"/>
      <field table="Attendance" field="Att_Mode_Code"     access="ViewOnly"/>
      <field table="Attendance" field="SchoolID"          access="ViewOnly"/>
      <field table="Attendance" field="Yearid"            access="ViewOnly"/>
      <field table="Attendance" field="CCID"              access="ViewOnly"/>
      <field table="Attendance" field="PeriodID"          access="ViewOnly"/>

      <field table="Attendance_Code" field="ID"                 access="ViewOnly"/>
      <field table="Attendance_Code" field="Att_Code"           access="ViewOnly"/>
      <field table="Attendance_Code" field="Description"        access="ViewOnly"/>
      <field table="Attendance_Code" field="Presence_Status_CD" access="ViewOnly"/>
      <field table="Attendance_Code" field="SchoolID"           access="ViewOnly"/>
      <field table="Attendance_Code" field="Yearid"             access="ViewOnly"/>

      <!-- ================================================================
           MANIFEST 11: grades. PGFinalGrades is the live gradebook value.
           StoredGrades is the fallback for closed terms.
           A null percent must stay null all the way to the UI. It is not
           a zero. See docs/plugin-install.md.
           ================================================================ -->
      <field table="PGFinalGrades" field="ID"             access="ViewOnly"/>
      <field table="PGFinalGrades" field="StudentID"      access="ViewOnly"/>
      <field table="PGFinalGrades" field="SectionID"      access="ViewOnly"/>
      <field table="PGFinalGrades" field="FinalGradeName" access="ViewOnly"/>
      <field table="PGFinalGrades" field="Grade"          access="ViewOnly"/>
      <field table="PGFinalGrades" field="Percent"        access="ViewOnly"/>
      <field table="PGFinalGrades" field="LastGradeUpdate" access="ViewOnly"/>

      <field table="StoredGrades" field="DCID"           access="ViewOnly"/>
      <field table="StoredGrades" field="StudentID"      access="ViewOnly"/>
      <field table="StoredGrades" field="SectionID"      access="ViewOnly"/>
      <field table="StoredGrades" field="Course_Number"  access="ViewOnly"/>
      <field table="StoredGrades" field="StoreCode"      access="ViewOnly"/>
      <field table="StoredGrades" field="Grade"          access="ViewOnly"/>
      <field table="StoredGrades" field="Percent"        access="ViewOnly"/>
      <field table="StoredGrades" field="TermID"         access="ViewOnly"/>
      <field table="StoredGrades" field="SchoolID"       access="ViewOnly"/>

      <!-- ================================================================
           Calendar scaffolding used to parameterize every query by school
           year and term. No query hardcodes a term id.
           ================================================================ -->
      <field table="Terms" field="ID"           access="ViewOnly"/>
      <field table="Terms" field="Abbreviation" access="ViewOnly"/>
      <field table="Terms" field="Name"         access="ViewOnly"/>
      <field table="Terms" field="FirstDay"     access="ViewOnly"/>
      <field table="Terms" field="LastDay"      access="ViewOnly"/>
      <field table="Terms" field="SchoolID"     access="ViewOnly"/>
      <field table="Terms" field="Yearid"       access="ViewOnly"/>
      <field table="Terms" field="IsYearRec"    access="ViewOnly"/>
      <field table="Terms" field="Portion"      access="ViewOnly"/>

      <field table="Schools" field="ID"           access="ViewOnly"/>
      <field table="Schools" field="School_Number" access="ViewOnly"/>
      <field table="Schools" field="Name"         access="ViewOnly"/>
      <field table="Schools" field="Abbreviation" access="ViewOnly"/>

      <!-- ================================================================
           MANIFEST 20: the gradebook. Added at 1.3.0.

           WHAT IT IS FOR. A student's own portal card answering "which work am
           I missing, and what is it worth". AssignmentScore.ISMISSING is the
           flag a teacher sets in PowerTeacher; nothing here infers it.

           EVERY FIELD BELOW ANSWERED 403 ON 2026-08-31, which is this repo's
           standard of proof that a column exists. Probed by
           sync/src/probe-gradebook-columns.ts. Nothing on a 400 is here.

           ⚠️ THE TABLE NAMES ARE SINGULAR AND UNPREFIXED, AND THAT IS THE WHOLE
           TRAP. This instance carries BOTH generations of the schema:

             PSM_Assignment         exists, 0 rows        Assignment         44,236
             PSM_AssignmentScore    exists, 0 rows        AssignmentScore 1,374,093
             PSM_AssignmentSection  absent                AssignmentSection  79,879

           The PSM_ tables are empty stubs. Two separate probes concluded this
           school does not use assignments at all, once from the PSM_ names and
           once from the PLURAL unprefixed names (Assignments, AssignmentScores)
           which both 404. A single letter separated "no gradebook data" from
           1.37 million scores. Do not re-point any of this at a PSM_ table.

           THE JOIN, and why it needs three tables:

             AssignmentScore.STUDENTSDCID        -> Students.DCID
             AssignmentScore.ASSIGNMENTSECTIONID -> AssignmentSection.ASSIGNMENTSECTIONID
             AssignmentSection.SECTIONSDCID      -> Sections.DCID

           AssignmentSection, not Assignment, is where the readable content
           lives: NAME, DESCRIPTION, DUEDATE and the point value are all on it.
           The Assignment table is nearly bare here (ASSIGNMENTID, YEARID and
           two audit columns), so it is requested only as the key that ties a
           multi-section assignment together.

           POINTS POSSIBLE IS `SCOREENTRYPOINTS`. `POINTSPOSSIBLE` answered 400
           on this table; it does not exist. TOTALPOINTVALUE is requested beside
           it because which one a section uses depends on its scoring type.

           WEIGHTING IS ONLY HALF ANSWERABLE, and the card must respect that.
           GradeCalculationType.TYPE says whether a section is total points or
           weighted. No weight column was found on TeacherCategory under any
           spelling tried, so for a WEIGHTED section this data can say which
           work is missing but NOT what handing it in would do to the grade.
           The card must refuse to project in that case rather than guess. See
           docs/gradebook-sourcing.md.

           DELIBERATELY ABSENT: every comment and free-text field on a score.
           WHOMODIFIEDID and WHENMODIFIED are not requested either; who edited a
           grade is a teacher-supervision question, and this is a student view.
           ================================================================ -->
      <field table="AssignmentScore" field="AssignmentSectionID" access="ViewOnly"/>
      <field table="AssignmentScore" field="StudentsDCID"        access="ViewOnly"/>
      <field table="AssignmentScore" field="ScorePoints"         access="ViewOnly"/>
      <field table="AssignmentScore" field="ScorePercent"        access="ViewOnly"/>
      <field table="AssignmentScore" field="ScoreLetterGrade"    access="ViewOnly"/>
      <field table="AssignmentScore" field="ScoreEntryDate"      access="ViewOnly"/>
      <field table="AssignmentScore" field="IsMissing"           access="ViewOnly"/>
      <field table="AssignmentScore" field="IsLate"              access="ViewOnly"/>
      <field table="AssignmentScore" field="IsExempt"            access="ViewOnly"/>
      <field table="AssignmentScore" field="IsAbsent"            access="ViewOnly"/>
      <field table="AssignmentScore" field="IsCollected"         access="ViewOnly"/>

      <field table="AssignmentSection" field="AssignmentSectionID"   access="ViewOnly"/>
      <field table="AssignmentSection" field="AssignmentID"          access="ViewOnly"/>
      <field table="AssignmentSection" field="SectionsDCID"          access="ViewOnly"/>
      <field table="AssignmentSection" field="Name"                  access="ViewOnly"/>
      <field table="AssignmentSection" field="Description"           access="ViewOnly"/>
      <field table="AssignmentSection" field="DueDate"               access="ViewOnly"/>
      <field table="AssignmentSection" field="ScoreEntryPoints"      access="ViewOnly"/>
      <field table="AssignmentSection" field="TotalPointValue"       access="ViewOnly"/>
      <field table="AssignmentSection" field="Weight"                access="ViewOnly"/>
      <field table="AssignmentSection" field="ExtraCreditPoints"     access="ViewOnly"/>
      <field table="AssignmentSection" field="IsCountedInFinalGrade" access="ViewOnly"/>
      <field table="AssignmentSection" field="IsScoringNeeded"       access="ViewOnly"/>
      <field table="AssignmentSection" field="ScoreType"             access="ViewOnly"/>
      <!-- AssignmentSection.YearID is NOT requested. It exists and is EMPTY on
           every row in this instance, and the 1.3.0 missing_work query filtered
           on it: HTTP 200, zero rows, no error anywhere. The year scope comes
           from Sections.TermID -> Terms.Yearid instead. Do not add it back
           without checking it is populated first. -->

      <field table="Assignment" field="AssignmentID" access="ViewOnly"/>
      <field table="Assignment" field="YearID"       access="ViewOnly"/>

      <field table="AssignmentCategoryAssoc" field="AssignmentSectionID" access="ViewOnly"/>
      <field table="AssignmentCategoryAssoc" field="TeacherCategoryID"   access="ViewOnly"/>

      <field table="TeacherCategory" field="TeacherCategoryID" access="ViewOnly"/>
      <field table="TeacherCategory" field="Name"              access="ViewOnly"/>
      <field table="TeacherCategory" field="DefaultScoreType"  access="ViewOnly"/>

      <field table="GradeCalculationType" field="GradeCalculationTypeID" access="ViewOnly"/>
      <field table="GradeCalculationType" field="Type"                   access="ViewOnly"/>
      <field table="GradeCalculationType" field="Abbreviation"           access="ViewOnly"/>

      <!-- ================================================================
           RESTRICTED BLOCK. Manifest 7, 8, 14.
           Everything below this line is column level restricted. It lands
           in its own staging tables, gets its own access tests in Phase 5,
           and gets its own line in the go / no go checklist.

           Manifest 7 and 8 are pending an answer to the open question in
           the prompt: what teacher facing decision do federal ethnicity and
           federal race codes inform? If no use case is named, delete this
           block, bump the plugin version, and have the SIS admin disable
           and re-enable the plugin.
           ================================================================ -->
      <field table="Students" field="FedEthnicity" access="ViewOnly"/>

      <field table="StudentRace" field="ID"        access="ViewOnly"/>
      <field table="StudentRace" field="StudentID" access="ViewOnly"/>
      <field table="StudentRace" field="RaceCD"    access="ViewOnly"/>

      <!-- Manifest 14: English Learner. California state extension tables.
           S_CA_STU_X is the current status. S_CA_STU_ELA_C is the history.
           If the probe reports these as not granted, the state extension
           is either not installed or named differently in this instance.
           Confirm with the SIS admin before assuming the data is absent. -->
      <field table="S_CA_STU_X" field="StudentsDCID" access="ViewOnly"/>
      <field table="S_CA_STU_X" field="ELAStatus"    access="ViewOnly"/>

      <field table="S_CA_STU_ELA_C" field="StudentsDCID"     access="ViewOnly"/>
      <field table="S_CA_STU_ELA_C" field="ELAStatus"        access="ViewOnly"/>
      <field table="S_CA_STU_ELA_C" field="ELAStatusStartDate" access="ViewOnly"/>

      <!-- ================================================================
           MANIFEST 12 and 13: IEP / Special Ed status and 504 status.
           DELIBERATELY ABSENT. The source is unconfirmed. Do not guess a
           table name here. Phase 1 resolves where this data actually lives
           in our instance, then this block gets filled in exactly once and
           the plugin is re-uploaded at version 1.1.0.
           See docs/field-sourcing.md for the questions to send the
           registrar and the SIS admin.
           ================================================================ -->

      <!-- ================================================================
           BEHAVIOR. Added at 1.1.0. Read only, like everything else here.

           WHY THIS TABLE AND NOT INCIDENT MANAGEMENT: PowerSchool ships two
           independent behavior models and a school uses one of them. This was
           measured rather than assumed, on 2026-08-12, through the count
           endpoint, which answers without a grant:
             GET /ws/schema/table/log/count       -> 16987
             GET /ws/schema/table/incident/count  -> 13
           Westbrook's behavior record is LOG. If that ratio ever inverts, this
           block is pointed at the wrong table and needs rewriting, not extending.

           WHY THE APP NEEDS IT: the Hub runs a complete parallel behavior
           economy (eight core behaviors at plus or minus 100 points, referrals,
           detentions, hall passes) that cannot see the SIS record at all. A
           teacher deducting Wildcat Cash for defiance currently cannot tell that
           the student already has three log entries this week, or was serving a
           suspension that day.

           DELIBERATELY ABSENT, and not an oversight:
             Log.Entry    the narrative CLOB. A log entry narrative routinely
                          names a second child or carries a medical detail, and
                          nothing in this product reads free text.
             Log.Subject  the title, same reason, weaker but still true.
             32 of the 34 Discipline_ columns. Only the two below inform a
                          teacher facing view. The rest are state reporting.
           ================================================================ -->
      <field table="Log" field="ID"                       access="ViewOnly"/>
      <field table="Log" field="StudentID"                access="ViewOnly"/>
      <field table="Log" field="SchoolID"                 access="ViewOnly"/>
      <field table="Log" field="Entry_Date"               access="ViewOnly"/>
      <field table="Log" field="Entry_Author"             access="ViewOnly"/>
      <field table="Log" field="LogTypeID"                access="ViewOnly"/>
      <field table="Log" field="Subtype"                  access="ViewOnly"/>
      <field table="Log" field="Consequence"              access="ViewOnly"/>
      <field table="Log" field="Discipline_ActionTaken"   access="ViewOnly"/>
      <field table="Log" field="Discipline_IncidentDate"  access="ViewOnly"/>

      <!-- GEN carries the school configured log type vocabulary. Without it a
           LogTypeID is an integer with no meaning, and the app would be showing
           teachers a number instead of "Defiance" or "Positive Referral". -->
      <field table="Gen" field="ID"        access="ViewOnly"/>
      <field table="Gen" field="Cat"       access="ViewOnly"/>
      <field table="Gen" field="Name"      access="ViewOnly"/>
      <field table="Gen" field="Value"     access="ViewOnly"/>
      <field table="Gen" field="SchoolID"  access="ViewOnly"/>
      <field table="Gen" field="SortOrder" access="ViewOnly"/>

  </access_request>

</plugin>
