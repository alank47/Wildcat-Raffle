# macOS
.DS_Store

# Secrets. The sync harness reads 1Password references from a local .env that
# never leaves the machine. .env.example is the tracked template.
.env
.env.*
!.env.example

# Build output. powerschool/out/ is regenerated by `npm run build:plugin`.
powerschool/out/
*.zip

node_modules/
*.log

# Generated dev harness: every state of the student pass card, side by side
# against the real stylesheet. Rebuild with node scripts/build-pass-harness.mjs.
pass-card-harness.html

# Generated dev harness: the student's desk dashboard in real viewports,
# against the real stylesheet. Rebuild with node scripts/build-dashboard-harness.mjs.
dashboard-harness.html

# Generated dev harness: every Wildcat Cash screen at once, against the real
# stylesheets. Rebuild with node scripts/build-cash-harness.mjs.
cash-harness.html
