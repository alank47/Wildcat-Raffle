# Copy to .env.local and fill in. (This file is named without a leading dot on
# purpose: .gitignore line 7 is `.env.*`, which would have silently swallowed a
# file called .env.local.example and shipped nothing.) .env.local is gitignored (*.local) and MUST
# stay that way: alank47/Wildcat-Raffle is a PUBLIC repository, so a Pro token
# committed here is a Pro token published to the internet.
#
# Both values come from your React Bits Pro dashboard. The registry base URL is
# read from the environment too, not hardcoded in components.json, so that a
# wrong or stale URL fails loudly here instead of silently 404ing for everyone
# who clones the repo.
#
# The shadcn CLI expands ${VAR} in registry urls, headers and params, and never
# logs the values.

# Base URL, no trailing slash. The CLI appends /{name}.json.
REACTBITS_PRO_REGISTRY=

# Bearer token.
REACTBITS_PRO_TOKEN=
