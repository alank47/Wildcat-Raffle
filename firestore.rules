rules_version = '2';

// Wildcat Rewards / Wildcat Raffle Firestore rules.
//
// WHY THIS FILE EXISTS
// The raffle_data collection previously answered callers that presented no
// credentials at all. These rules require a signed in Firebase identity on
// every read and every write.
//
// DEPLOY ORDER MATTERS. Two things must be true BEFORE these rules ship, or
// every read and write is denied and the app goes offline for every user:
//
//   1. The sign in patch in script.js is live. (Done.)
//   2. Anonymous sign in is ENABLED in Firebase Console > Authentication >
//      Sign-in method. As of 2026-08-11 it is NOT, and the project returns
//      CONFIGURATION_NOT_FOUND. The app handles this by running unauthenticated,
//      which only works while the deployed rules are still permissive.
//
// PREFLIGHT: load the site, open the console, and check `window.wildcatAuthReady`.
// Deploy these rules only when it is true.
//
// WHAT THIS IS NOT
// This is a floor, not a ceiling. Anonymous auth stops drive by reads from a
// stranger with curl. It does not stop someone who opens devtools, copies the
// public config, and signs in anonymously themselves. Real authorization
// needs a server side identity, which is the Entra ID / Azure work planned
// next. Until then, treat everything in raffle_data as sensitive but not
// secret, and do not add new secrets to it.

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny. Any path not explicitly granted below is refused.
    // Firestore rules are OR based: a request is allowed only if some rule
    // grants it, so this block is here to make the intent unmistakable to
    // the next reader rather than to do work on its own.
    match /{document=**} {
      allow read, write: if false;
    }

    // Application data. Requires a signed in Firebase identity.
    //
    // Step 1 (now):   anonymous auth, so the app keeps working and the
    //                 collection stops answering unauthenticated callers.
    // Step 2 (Azure): replace this with a check on a verified claim, for
    //                 example request.auth.token.email.matches('.*@lapromisefund[.]org$')
    //                 once Entra ID issues the token. The line is written
    //                 below, commented, so the swap is a one line change.
    match /raffle_data/{docId} {
      allow read, write: if request.auth != null;

      // AZURE / ENTRA ID VERSION. Uncomment and delete the line above once
      // federated sign in is issuing tokens with a verified email claim.
      // allow read, write: if request.auth != null
      //   && request.auth.token.email_verified == true
      //   && request.auth.token.email.matches('.*@lapromisefund[.]org$');
    }
  }
}
